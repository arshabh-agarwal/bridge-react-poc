{
  "name": "@poc/bridge-ember",
  "version": "0.0.0",
  "private": true,
  "description": "Host-side adapter for mounting @module-federation/bridge-react remotes in Ember apps",
  "keywords": [
    "ember-addon"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "start": "rollup --config --watch",
    "prepack": "rollup --config"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0",
    "@module-federation/runtime": "^2.9.0"
  },
  "peerDependencies": {
    "@ember/render-modifiers": "^2.1.0 || ^3.0.0 || ^4.0.0",
    "ember-source": ">= 3.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.25.0",
    "@babel/plugin-transform-class-properties": "^7.25.0",
    "@embroider/addon-dev": "^8.4.0",
    "@rollup/plugin-babel": "^6.0.4",
    "rollup": "^4.30.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/remote-mount.js": "./dist/_app_/components/remote-mount.js",
      "./services/remote-loader.js": "./dist/_app_/services/remote-loader.js"
    }
  }
}
