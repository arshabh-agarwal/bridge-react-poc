{
  "name": "host-ember-webpack",
  "version": "0.0.0",
  "private": true,
  "description": "Ember 3.28 host (Embroider + webpack) mounting bridge-react remotes",
  "license": "MIT",
  "scripts": {
    "build": "ember build --environment=production",
    "dev": "ember serve --port 4200",
