<div class="hg">
  <header class="hg__header">
    <strong>host-ember-webpack</strong>
    <code>Ember {{this.emberVersion}}</code>
    <code>Embroider + webpack</code>
    <code data-testid="host-pathname">pathname={{this.router.currentURL}}</code>
  </header>

  <nav class="hg__nav" aria-label="Remotes">
    <h2>Remotes</h2>
    <LinkTo @route="index">Host home</LinkTo>
    <LinkTo @route="remote18">
      React 18
      <span class="nav-sub">remote18 / react-router</span>
    </LinkTo>
    <LinkTo @route="remote19">
      React 19
      <span class="nav-sub">remote19 / react-router</span>
    </LinkTo>
  </nav>

  <main class="hg__main">
    {{outlet}}
  </main>

  <footer class="hg__footer">
    Host owns the shell, side nav and tabs. Everything inside the dashed box is rendered by the
    remote's own React and react-router.
  </footer>
</div>
