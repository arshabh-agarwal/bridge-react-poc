{
  "name": "bridge-poc",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "dev:remotes": "pnpm -r --parallel --filter './apps/remote-*' dev",
    "dev:react-hosts": "pnpm -r --parallel --filter './apps/host-react*' dev",
    "dev:ember-hosts": "pnpm -r --parallel --filter './apps/host-ember*' dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "preview": "pnpm -r --parallel --filter './apps/*' preview",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
